# ==============================================================================
# FinCore Environment Configuration (SAFE PLACEHOLDER VALUES ONLY)
# Copy to .env and replace placeholders for local development.
# NEVER commit real secrets or production credentials.
# ==============================================================================

NODE_ENV=development
APP_ENV=local

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fincore_db
POSTGRES_USER=fincore_app
POSTGRES_PASSWORD=replace_with_local_dev_password
DATABASE_URL=postgresql://fincore_app:replace_with_local_dev_password@localhost:5432/fincore_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Core API (Node.js / Express)
API_PORT=4000
JWT_ACCESS_SECRET=replace_with_min_32_char_random_access_secret
JWT_REFRESH_SECRET=replace_with_min_32_char_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REAUTH_SECRET=replace_with_min_32_char_reauth_secret
CORS_ORIGIN=http://localhost:3000

# Analytics & Financial Math Service (Python / FastAPI)
ANALYTICS_PORT=8000
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_INTERNAL_KEY=replace_with_internal_service_key

# Sandbox Payment & Notification Providers (TEST MODE ONLY)
SANDBOX_PAYMENT_WEBHOOK_SECRET=whsec_sandbox_replace_with_test_secret
SANDBOX_PAYMENT_MODE=test
SANDBOX_NOTIFICATION_MODE=sandbox

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=FinCore (Simulated Sandbox)
